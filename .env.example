# ThreatLens Email Threat Detection — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Type: Web Application
# Redirect URI: http://127.0.0.1:8088/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# ── Google APIs ───────────────────────────────────────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your-gemini-api-key

# Safe Browsing: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
SAFE_BROWSING_API_KEY=your-safe-browsing-api-key

# ── Cloud Pub/Sub ─────────────────────────────────────────────────────────────
# Format: projects/{PROJECT_ID}/topics/{TOPIC_NAME}
# Grant gmail-api-push@system.gserviceaccount.com "Pub/Sub Publisher" role
PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push

# Pub/Sub push endpoint audience (the public HTTPS URL of this app + /api/pubsub/push)
# Used for JWT verification of incoming push requests
PUBSUB_PUSH_AUDIENCE=https://your-ngrok-url.ngrok.io/api/pubsub/push

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-base64-encoded-32-byte-fernet-key

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-minimum-32-character-random-session-secret-here

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in project root (zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./threat_detection.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/threat_detection

# ── GeoIP ─────────────────────────────────────────────────────────────────────
# Leave empty to use ip-api.com (free, 45 req/min limit)
# Or set path to GeoLite2-City.mmdb (download from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data)
GEOIP_DB_PATH=
GEOIP_USE_IPAPI=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8088
DEBUG=false
